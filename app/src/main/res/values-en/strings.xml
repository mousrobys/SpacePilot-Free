    <string name="settings_version">Version %1$s</string>
    <string name="settings_about_title">About SpacePilot Free</string>
    <string name="settings_about_text">SpacePilot Free is a free, local app for analyzing accessible storage, finding large files and duplicates, and managing files.\n\nThere are no ads, subscriptions, registration, custom servers or network requests. All processing and settings stay on the device.\n\nFiles are deleted only after user confirmation. The app does not bypass Android system restrictions.</string>
    <string name="settings_privacy_title">Privacy policy</string>
    <string name="settings_privacy_text">SpacePilot Free runs entirely on the device.\n\nThe app does not request the INTERNET permission, contains no ad SDKs, analytics or telemetry, and does not send file names, paths, contents or other user data to external servers.\n\nAnalysis uses MediaStore and the Storage Access Framework. Media permissions are used only to read accessible files; folder access is granted through the Android system picker and can be disconnected by the user. The app does not use MANAGE_EXTERNAL_STORAGE and does not attempt to access other apps’ private data.\n\nSettings, operation history and the last-scan cache are stored locally on the device. History and cache can be cleared in Settings. Uninstalling the app removes its local data through the system.\n\nFile deletion is performed through system mechanisms after confirmation. SpacePilot Free does not delete files automatically and does not verify APKs for malicious content.\n\nLast updated: October 23, 2026.</string>
    <string name="settings_reset_confirm_title">Reset settings?</string>
    <string name="settings_reset_confirm_message">Theme and language will return to defaults. History, scan results and folder access will not change.</string>
    <string name="settings_history_confirm_title">Clear history?</string>
    <string name="settings_history_confirm_message">Operation history and the last scan results will be removed. Files on the device will not be affected.</string>
    <string name="settings_history_cleared">Local history cleared</string>
    <string name="settings_folder_access_note">Access remains until disconnected, the app is uninstalled, or the system revokes permission.</string>

